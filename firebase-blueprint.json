{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Trusted administrator account record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the administrator."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of admin creation."
        }
      },
      "required": ["uid", "createdAt"]
    },
    "SellerPublic": {
      "title": "SellerPublic",
      "description": "Public storefront and location profile for a registered vendor.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the seller account owner."
        },
        "businessName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Official registered business name."
        },
        "category": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Primary commercial category."
        },
        "city": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "City hub where the seller operates."
        },
        "district": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Industrial zone or commercial district."
        },
        "lat": {
          "type": "number",
          "description": "Latitude coordinate for spatial distance comparison."
        },
        "lng": {
          "type": "number",
          "description": "Longitude coordinate for spatial distance comparison."
        },
        "gstinMasked": {
          "type": "string",
          "minLength": 5,
          "maxLength": 30,
          "description": "Publicly visible masked tax/registration identifier."
        },
        "isVerified": {
          "type": "boolean",
          "description": "Whether all seller compliance documents passed verification."
        },
        "verificationStatus": {
          "type": "string",
          "enum": ["verified", "pending", "rejected"],
          "description": "Current verification workflow status."
        },
        "serviceRadiusKm": {
          "type": "number",
          "description": "Service and delivery coverage radius in kilometers."
        },
        "responseRatePct": {
          "type": "number",
          "description": "Historical inquiry response percentage."
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended"],
          "description": "Public visibility state of the seller."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "ownerId",
        "businessName",
        "category",
        "city",
        "district",
        "lat",
        "lng",
        "gstinMasked",
        "isVerified",
        "verificationStatus",
        "serviceRadiusKm",
        "responseRatePct",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "SellerPrivate": {
      "title": "SellerPrivate",
      "description": "Isolated compliance documents and private contact details for a seller.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the seller owner."
        },
        "taxIdFull": {
          "type": "string",
          "minLength": 8,
          "maxLength": 32,
          "description": "Full GSTIN or Tax Registration Number."
        },
        "tradeLicenseNumber": {
          "type": "string",
          "minLength": 6,
          "maxLength": 40,
          "description": "Municipal or commercial trade license code."
        },
        "isoCertRef": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40,
          "description": "Quality or safety certification reference."
        },
        "registeredStreet": {
          "type": "string",
          "minLength": 5,
          "maxLength": 200,
          "description": "Full legal warehouse or office street location."
        },
        "contactPhone": {
          "type": "string",
          "minLength": 7,
          "maxLength": 24,
          "description": "Direct business phone line for verified compliance."
        },
        "contactEmail": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120,
          "description": "Direct business email for verified compliance."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "taxIdFull",
        "tradeLicenseNumber",
        "isoCertRef",
        "registeredStreet",
        "contactPhone",
        "contactEmail",
        "createdAt",
        "updatedAt"
      ]
    },
    "Listing": {
      "title": "Listing",
      "description": "Product or localized service listing offered by a seller.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated Firebase UID who manages this listing."
        },
        "sellerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Seller profile document ID in /sellers/{sellerId}."
        },
        "sellerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Display name of the seller."
        },
        "sellerVerified": {
          "type": "boolean",
          "description": "Whether the seller holds a verified badge."
        },
        "productGroupKey": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Normalized model/service key used to compare prices across multiple sellers."
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 140,
          "description": "Title of the product or service."
        },
        "category": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Marketplace category."
        },
        "listingType": {
          "type": "string",
          "enum": ["product", "service"],
          "description": "Distinguishes physical products from on-site/local services."
        },
        "price": {
          "type": "number",
          "description": "Quoted unit price in USD."
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "description": "Pricing unit (e.g., per unit, per day, per installation)."
        },
        "stockCount": {
          "type": "number",
          "description": "Available inventory units or monthly service slots."
        },
        "reorderPoint": {
          "type": "number",
          "description": "Threshold for low-stock alert in inventory analytics."
        },
        "minOrderQty": {
          "type": "number",
          "description": "Minimum inquiry quantity."
        },
        "leadTimeDays": {
          "type": "number",
          "description": "Estimated dispatch or on-site mobilization lead time in days."
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 800,
          "description": "Detailed specification and scope summary."
        },
        "city": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Seller dispatch or service city."
        },
        "district": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Specific hub or district."
        },
        "lat": {
          "type": "number",
          "description": "Seller location latitude."
        },
        "lng": {
          "type": "number",
          "description": "Seller location longitude."
        },
        "visualKey": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Identifier for high-precision visual rendering."
        },
        "status": {
          "type": "string",
          "enum": ["active", "draft", "archived"],
          "description": "Publication status; archived is a terminal state."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "sellerId",
        "sellerName",
        "sellerVerified",
        "productGroupKey",
        "title",
        "category",
        "listingType",
        "price",
        "unit",
        "stockCount",
        "reorderPoint",
        "minOrderQty",
        "leadTimeDays",
        "description",
        "city",
        "district",
        "lat",
        "lng",
        "visualKey",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Direct buyer-to-seller inquiry message and price/location quote request.",
      "type": "object",
      "properties": {
        "listingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Referenced listing ID."
        },
        "listingTitle": {
          "type": "string",
          "minLength": 3,
          "maxLength": 140,
          "description": "Snapshot of listing title."
        },
        "sellerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Recipient seller profile ID."
        },
        "sellerOwnerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Recipient seller account owner UID."
        },
        "sellerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Recipient seller business name."
        },
        "buyerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated buyer UID initiating the inquiry."
        },
        "buyerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Buyer display or company name."
        },
        "buyerLocation": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Buyer city/region for proximity coordination."
        },
        "requestedQty": {
          "type": "number",
          "description": "Requested units or service days."
        },
        "targetPrice": {
          "type": "number",
          "description": "Buyer proposed unit price or budget."
        },
        "preferredContactMethod": {
          "type": "string",
          "enum": ["portal", "phone_callback", "site_visit"],
          "description": "How the buyer prefers to proceed with the seller."
        },
        "message": {
          "type": "string",
          "minLength": 5,
          "maxLength": 600,
          "description": "Buyer inquiry specifications and questions."
        },
        "sellerReply": {
          "type": "string",
          "minLength": 0,
          "maxLength": 600,
          "description": "Direct response from the seller."
        },
        "status": {
          "type": "string",
          "enum": ["open", "responded", "closed"],
          "description": "Workflow state; closed is a terminal state."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "listingId",
        "listingTitle",
        "sellerId",
        "sellerOwnerId",
        "sellerName",
        "buyerId",
        "buyerName",
        "buyerLocation",
        "requestedQty",
        "targetPrice",
        "preferredContactMethod",
        "message",
        "sellerReply",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "System administrators with elevated moderation capabilities."
    },
    "/sellers/{sellerId}": {
      "schema": { "$ref": "#/entities/SellerPublic" },
      "description": "Public seller profiles, locations, and verification badges."
    },
    "/seller_private/{sellerId}": {
      "schema": { "$ref": "#/entities/SellerPrivate" },
      "description": "Strictly isolated seller KYC compliance documents and private contact info."
    },
    "/listings/{listingId}": {
      "schema": { "$ref": "#/entities/Listing" },
      "description": "Multi-vendor product and service listings with location and inventory data."
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "Direct customer-to-seller inquiries and responses."
    }
  }
}
